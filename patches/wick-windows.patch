+/// The proxy recorded by [`set_proxy`], if any. The Windows CEF renderer is
+/// started with it so rendered pages leave through the same route as every
+/// other fetch instead of going around a configured proxy.
+#[cfg(windows)]
+pub(crate) fn effective_proxy() -> Option<String> {
+    EFFECTIVE_PROXY
+        .get()
+        .and_then(|p| p.clone())
+        .map(|p| p.trim().to_string())
+        .filter(|p| !p.is_empty())
+}
