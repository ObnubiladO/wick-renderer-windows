@@ -47,6 +47,42 @@ pub async fn activate(_legacy_key: Option<String>) -> Result<()> {
         println!("  curl -fsSL {} | sudo WICK_VERSION={} -E bash", script_url, version);
     }
 
+    #[cfg(target_os = "windows")]
+    {
+        // The Windows renderer is compiled locally with MSVC by
+        // scripts/install-cef-windows.ps1. Run the script when it sits next
+        // to this binary or WICK_CEF_INSTALLER names it; otherwise explain
+        // how to run it from a checkout (it needs the rust/cef sources).
+        let script = std::env::var_os("WICK_CEF_INSTALLER")
+            .map(std::path::PathBuf::from)
+            .or_else(|| {
+                std::env::current_exe()
+                    .ok()
+                    .and_then(|p| p.parent().map(|d| d.join("install-cef-windows.ps1")))
+            })
+            .filter(|p| p.exists());
+        match script {
+            Some(script) => {
+                let status = std::process::Command::new("powershell.exe")
+                    .args(["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"])
+                    .arg(&script)
+                    .status()?;
+                if !status.success() {
+                    println!("Auto-install failed. Run manually:");
+                    println!(
+                        "  powershell -ExecutionPolicy Bypass -File \"{}\"",
+                        script.display()
+                    );
+                }
+            }
+            None => {
+                println!("Run this from a wick checkout (wick {}) to build and install it:", ref_name);
+                println!("  powershell -ExecutionPolicy Bypass -File scripts\\install-cef-windows.ps1");
+                println!("It needs Visual Studio 2022 Build Tools with the C++ workload.");
+            }
+        }
+    }
+
     Ok(())
 }
 
